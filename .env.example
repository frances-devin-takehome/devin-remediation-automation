# Shared secret configured on the GitHub webhook; used to verify X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=replace-me

# Devin service-user API key (requires the ManageOrgSessions permission).
DEVIN_API_KEY=replace-me

# Devin organization ID used in the v3 Organization API path.
DEVIN_ORG_ID=replace-me

# Optional: override the Devin API base URL (defaults to https://api.devin.ai).
# DEVIN_API_BASE_URL=https://api.devin.ai

# Optional: repository allowed to dispatch remediation sessions
# (defaults to frances-devin-takehome/superset).
# ALLOWED_REPOSITORY=frances-devin-takehome/superset
